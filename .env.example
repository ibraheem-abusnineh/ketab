# Feedback Email Configuration
# Email address for receiving feedback submissions
# Copy this file to .env and update with your email address
REACT_APP_FEEDBACK_EMAIL=visiblevoices@qra.jo

# Developer password (backend) — used at the Cover page gear icon
# Default: dev_ketab_2026
DEV_PASSWORD=your_secure_password

# S3 persistent storage (AWS App Runner / production)
# If set, visits and notifications are synced to S3 for persistence across deploys
S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1
